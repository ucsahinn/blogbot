{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OPE",
    "version": "0.1.45",
  "identifier": "app.blogbot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web --workspace @blogbot/desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OPE · OpenPostEditör",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "capabilities": ["desktop-main"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/blogbot-engine", "binaries/blogbot-fetcher"],
    "resources": ["resources/pglite/*", "resources/engine-node_modules/**/*", "resources/secure-restore/*"],
    "targets": ["msi", "nsis"],
    "category": "Productivity",
    "shortDescription": "Seçtiğiniz site için yerel editoryal otomasyon",
    "longDescription": "Kaynak tarama, taslak, inceleme, onay ve GitHub yayın akışını kullanıcının Windows bilgisayarında çalıştıran yerel OPE uygulaması.",
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "upgradeCode": "9dbe23f1-0eea-4a63-b194-43ff2d786b79"
      }
    }
  }
}
