{
  "name": "blogbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:all",
    "test:all": "npm run test:unit && npm run test:apps && npm run test:integration",
    "test:unit": "node --test --experimental-transform-types \"tests/unit/*.test.ts\"",
    "test:apps": "node --test --experimental-transform-types \"apps/desktop/tests/*.test.ts\" \"apps/codex-runner/tests/*.test.ts\"",
    "test:integration": "node --test --experimental-transform-types \"tests/integration/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspace @blogbot/desktop",
    "tauri": "npm run tauri --workspace @blogbot/desktop --",
    "build:engine": "node scripts/build-engine-sidecar.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "smoke:engine": "node scripts/smoke-engine-sidecar.mjs",
    "smoke:fetcher": "node scripts/smoke-fetcher-sidecar.mjs",
    "desktop:preflight": "node scripts/desktop-preflight.mjs",
    "desktop:preflight:json": "node scripts/desktop-preflight.mjs --json",
    "security:scan": "node --experimental-transform-types scripts/security-scan.ts",
    "security:rust": "cargo audit --file apps/desktop/src-tauri/Cargo.lock --target-os windows --target-arch x86_64",
    "security:verify": "npm run security:scan && npm audit --audit-level=high --offline && npm run security:rust && gitleaks detect --no-git --redact --config .gitleaks.toml --source .",
    "native:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "native:lint": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check:all": "npm run test:all && npm run lint && npm run typecheck && npm run build && npm run build:engine && npm run smoke:engine && npm run smoke:fetcher && npm run security:verify && npm run native:test && npm run native:lint",
    "icons:generate": "node --experimental-transform-types scripts/generate-desktop-icons.ts",
    "pilot:report": "node --experimental-transform-types scripts/pilot-report.ts",
    "token:audit": "node scripts/token-audit.mjs",
    "test:browser": "playwright test",
    "smoke:native-webview": "node scripts/native-webview-smoke.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "esbuild": "^0.25.12",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18"
  }
}
